digraph Research {
graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.30, ranksep=0.55, ordering=out, splines=polyline, fontname="Arial", labelloc=t, label="COMPLETE RESEARCH TREE | Research logic, not a timeline | 29 October 2026
Read top to bottom; E-numbers identify preserved evidence groups.", fontsize=20];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, margin="0.16,0.13", color="#C5D1DF", penwidth=1.1];
edge [color="#8094AB", penwidth=1.2, arrowsize=0.65, fontname="Arial", fontsize=10];
purpose [label="RESEARCH QUESTION\n\nDetect attacks within benign background\nusing superimposed local traffic sequences", fillcolor="#182A42", fontcolor="#FFFFFF"];
data [label="1  DEFINE THE DATA AND COMPOSITION\n\nObservation unit, local time grid,\ninformation content and split policy", fillcolor="#1D5D9B", fontcolor="#FFFFFF"];
view [label="Observation perspective  [E01]\n\nSource / destination / endpoint / network\nAdopt source-IP behavior\nAttack concentration differs across views", fillcolor="#FFFFFF", fontcolor="#182A42"];
scale [label="Sequence scale  [E02]\n\n50 / 100 / 200 / 500 / 1000 seconds\nMedian active-bucket count = 1\nLonger windows add context unevenly", fillcolor="#FFFFFF", fontcolor="#182A42"];
hybrid [label="Natural background  [E02]\n\n4562 / 5210 hybrid 100s windows\ncontain Infilteration: 87.56%\nBackground exposure differs by attack", fillcolor="#FFFFFF", fontcolor="#182A42"];
features [label="Feature support  [E03]\n\n55 raw fields; legacy 88-feature audit\n12 zero slots; CIC-specific L7 vocabulary\nExplicit sum / mean / histogram semantics", fillcolor="#FFFFFF", fontcolor="#182A42"];
split [label="Split feasibility  [E04-E05]\n\nEight candidate partitions\nGlobal 15min blocks + coverage reservations\n100s guards + actual-flow-end exclusions", fillcolor="#FFFFFF", fontcolor="#182A42"];
contract [label="ADOPTED DATA CONTRACT  [E05,E12]\n\n100s sequence; ten 10s buckets; internal mask\nKeep originals; add P B+A and P B+B\nReal train donors; different sources; audited pairs\n6:2:2 target; real-only validation/test", fillcolor="#EAF5EF", fontcolor="#182A42"];
representation [label="2  COMPARE REPRESENTATION CHOICES\n\nHow should two traffic activities\nbe combined for downstream learning?", fillcolor="#1D5D9B", fontcolor="#FFFFFF"];
event [label="Event-union reference  [E05]\n\nAlign raw flow sequences; merge records\nRecompute bucket aggregates\nCompleted original export: 228D", fillcolor="#FFFFFF", fontcolor="#182A42"];
s1 [label="Scheme1  [E06-E08]\n\nExact statistic composition\nplus field-level category representations\n137D; validation AP 3.44%", fillcolor="#FFFFFF", fontcolor="#182A42"];
s1l2 [label="Scheme1 + L2  [E07-E08]\n\nNormalize each complete 137D bucket\nValidation AP: 3.44% -> 10.40%\nMeasured benefit from amplitude control", fillcolor="#FFFFFF", fontcolor="#182A42"];
s2 [label="Scheme2  [E06,E12]\n\nLearn and freeze a whole-bucket encoder\n64D unit donor vectors add, then L2\nAppend a separate scaled log-flow count", fillcolor="#FFFFFF", fontcolor="#182A42"];
mix [label="Composition response  [E09-E10]\n\nNatural subgroups + controlled flow mixtures\nUnion encoding and vector addition differ\nTrain-derived stress evidence", fillcolor="#FFFFFF", fontcolor="#182A42"];
choose [label="COMMON PIPELINE: SCHEME2  [E11-E12]\n\nTemporal AE + readout, frozen real test\nAP 14.93% vs 7.27% for Scheme1+L2\nROC-AUC 0.84948 vs 0.82768\nSelected input: [10,65], default zero shift", fillcolor="#EAF5EF", fontcolor="#182A42"];
models [label="3  COMPARE DETECTORS  [E13]\n\nHistorical seed4266 / real validation AP\nLSTM 61.79%; Hybrid 60.86%\nCNN 60.18%; XGBoost 50.52%\nShared inputs, group weights and FPR policy", fillcolor="#1D5D9B", fontcolor="#FFFFFF"];
baseline [label="WORKING BASELINE: LSTM  [E22-E23]\n\nFive-seed neural AP means are close\nLSTM 61.25 / CNN 61.43 / Hybrid 60.97%\nStrict-FPR LSTM recall SD = 0.40 pp\nKeep other models for complementary behavior", fillcolor="#EAF5EF", fontcolor="#182A42"];
temporal [label="3A  TEMPORAL SENSITIVITY\n\nPosition, context length and\naggregation resolution are separate questions", fillcolor="#1D5D9B", fontcolor="#FFFFFF"];
difficulty [label="3B  EXPLAIN ATTACK DIFFERENCES\n\nProjector + native high-dimensional geometry\nTP/FN, occupancy, host and flow-level slices", fillcolor="#1D5D9B", fontcolor="#FFFFFF"];
transfer [label="3C  TRAINING-HOLDOUT TRANSFER\n\nSame binary detection task\nCompare related-subtype removal\nwith removal of all flooding exemplars", fillcolor="#1D5D9B", fontcolor="#FFFFFF"];
circular [label="Circular shift  [E21-E23]\n\nRotate ten positions by five; move masks too\n4 models x 5 seeds x 2 orders = 40 fits\n36 new fits + 4 reused shifted fits", fillcolor="#FFFFFF", fontcolor="#182A42"];
circular_result [label="Observed rotation response\n\nMean AP changes: -0.040 / -0.076 /\n+0.116 / -0.002 pp (XGB/LSTM/CNN/Hybrid)\nLSTM Web R@1%: 35.58 -> 29.83%\nLocalized type/threshold sensitivity", fillcolor="#EAF2FA", fontcolor="#182A42"];
windows [label="Window / bucket scale  [E20,E24]\n\nPast-context availability + new LSTM fits\n200s/10s; 200s/20s; 400s/10s; 400s/40s\nExpanded support changes eligible cohorts", fillcolor="#FFFFFF", fontcolor="#182A42"];
windows_result [label="Observed scale response\n\n400s/40s Web R@1% = 58.12%\nDifferent durations retain different cases\nContext availability and detection\nare measured separately", fillcolor="#EAF2FA", fontcolor="#182A42"];
web [label="WEB: ISOLATED LOCAL EVIDENCE  [E23]\n\n171/181 have attack flows in one bucket\n96/181 have one active traffic bucket\nSingle-bucket R@1%: XGB 64.79%\nvs LSTM 38.75% (five-seed means)", fillcolor="#EAF2FA", fontcolor="#182A42"];
inf [label="INFILTERATION: DISTINCT PROFILES  [E16-E19]\n\nHost composition changes average recall\nTP/FN differ in native-space overlap\n10/34 inspected pure misses have\nexact benign counterparts before encoding", fillcolor="#EAF2FA", fontcolor="#182A42"];
pool [label="Context and attention  [E25-E26]\n\nOracle background removal often lowers scores\nLearned attention targets attack positions\nSequence-level gains vary by subgroup\nContext weighting differs from discrimination", fillcolor="#FFFFFF", fontcolor="#182A42"];
dist [label="Information extension  [E27-E28]\n\nTrain-only block/host feature probes\nAdd 15 flow-distribution statistics; refit encoder\nWeb R@1%: 25.97 -> 36.46%\nInfilteration: 72.95 -> 70.77%", fillcolor="#FFFFFF", fontcolor="#182A42"];
flows [label="Within-bucket diagnosis  [E29]\n\nInspect all 366 Infilteration sequences\nTCP/3389: minority-attack mixing sensitivity\nUDP/53: attack-heavy representation sensitivity\nOracle flow removal separates these profiles", fillcolor="#FFFFFF", fontcolor="#182A42"];
aux [label="Bucket supervision  [E30]\n\nUse existing temporal labels; lambda=0.5\nTop-bucket hit: 116/135 = 85.9%\nUniform active-bucket reference: 54.4%\nLocalization is learnable; sequence gains small", fillcolor="#FFFFFF", fontcolor="#182A42"];
hold_a [label="A  ONE SUBTYPE PER FAMILY  [E34]\n\nRemove XSS + SlowHTTPTest + HOIC together\n216 training positives removed; P=7877\nRelated Web/DoS/DDoS types remain\nOne fixed configuration; three training seeds", fillcolor="#FFFFFF", fontcolor="#182A42"];
hold_a_result [label="A  RELATED-TYPE TRANSFER\n\nTeam frozen-test pooled R@1% (n=134)\nCNN 99.00%; Hybrid 98.76%\nLSTM 98.76%; XGB 99.00%\nHigh detection with sibling patterns retained", fillcolor="#EAF2FA", fontcolor="#182A42"];
hold_b [label="B  ALL FLOODING REMOVED  [E34]\n\nRemove all seven DoS + DDoS labels\n313 training positives removed; P=7780\nSame validation/test populations\nControl and holdout paired over three seeds", fillcolor="#FFFFFF", fontcolor="#182A42"];
hold_b_result [label="B  TRANSFER IS PATTERN-DEPENDENT\n\nTeam frozen-test pooled R@1% (n=202)\nCNN/Hybrid 68.32%; LSTM 72.94%\nXGB 68.65%; paired losses 26.57-31.68 pp\nHigh-volume subtypes remain easier", fillcolor="#EAF2FA", fontcolor="#182A42"];
hold_geom [label="Representation comparison  [E31-E32]\n\nSame 4917 validation IDs after set-A fit\nRetained Web/Infilteration benign neighbors\nstay close; Bot-HOIC and SQL-XSS mix changes\nGeometry complements binary detection", fillcolor="#FFFFFF", fontcolor="#182A42"];
hold_scope [label="READ THE HOLDOUT SCOPE  [E34-E35]\n\nPrimary-label removal; mixed memberships audited\nTransforms refit per arm; validation retains types\nSeeds measure retraining variation on fixed data\nHistorical test reused; team report is committed", fillcolor="#F0F2F5", fontcolor="#526579"];
purpose -> data;
data -> view;
data -> scale;
data -> hybrid;
data -> features;
data -> split;
view -> contract;
scale -> contract;
hybrid -> contract;
features -> contract;
split -> contract;
contract -> representation;
representation -> event;
representation -> s1;
representation -> s2;
s1 -> s1l2 [label="controlled normalization"];
event -> mix;
s1l2 -> mix;
s2 -> mix;
mix -> choose [label="common detection evaluation"];
choose -> models;
models -> baseline;
baseline -> temporal;
baseline -> difficulty;
models -> transfer [label="four-family controls"];
temporal -> circular;
circular -> circular_result;
temporal -> windows;
windows -> windows_result;
difficulty -> web;
difficulty -> inf;
web -> pool;
inf -> pool;
web -> dist;
inf -> dist;
dist -> flows;
inf -> aux;
transfer -> hold_a;
transfer -> hold_b;
hold_a -> hold_a_result;
hold_b -> hold_b_result;
hold_a_result -> hold_geom;
hold_a_result -> hold_scope;
hold_b_result -> hold_scope;
}

# Shared Scheme2 model screening data caches and unique experiment outputs.
/train/cache/
/train/runs/
/train/*/runs/
/train/tests/artifacts/

# Reproducible generated data and experiment artifacts
processed_binary_temporal*/
experiments/

# CIC generated outputs at every workflow depth stay local.
/CIC_new/**/outputs/
/CIC_new/maintenance/

# Full comparison evidence, runtime snapshots and machine-specific cleanup audits
# remain in the local archive. Share only the curated conclusions and test results.
/CIC_new/reports/superimposition_comparison_20261022/*
!/CIC_new/reports/superimposition_comparison_20261022/SUMMARY.md
!/CIC_new/reports/superimposition_comparison_20261022/TEST_RESULTS.md
!/CIC_new/reports/superimposition_comparison_20261022/test_metrics.json

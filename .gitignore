.DS_Store
__pycache__/
*.pyc
.venv*/
.vscode/
.matplotlib-cache/
node_modules/
~$*

# Local archives and cleanup recovery records.
/archive/
/_local_archive/

# Local source data and the delivered Scheme2 dataset.
/datasets/*
!/datasets/README.md
!/datasets/NetFlow_v3_Features.csv

# Reproducible Scheme2 construction outputs and representation checkpoints.
/CIC_new/outputs/

# Downstream model caches, runs, comparisons, and fixture artifacts.
/train/cache/
/train/runs/
/train/*/runs/
/train/comparisons/
/train/tests/artifacts/

# Delivered training datasets may also be placed beside training entry points.
/train/dataset*/

# Independent Phase II workflow: source is shared, generated material stays local.
/experiments/holdout/CIC_new/outputs/
/experiments/holdout/train/cache/
/experiments/holdout/train/runs/
/experiments/holdout/train/*/runs/
/experiments/holdout/train/comparisons/
/experiments/holdout/train/tests/artifacts/
/experiments/holdout/train/dataset*/
/experiments/holdout/datasets/
/experiments/holdout/output/

# Generated arrays, learned weights, serialized models and source databases.
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.ubj
*.joblib
*.onnx
*.pkl
*.pickle
*.db
*.sqlite
*.sqlite3

# Detailed local research maps contain machine-specific evidence inventories.
# Share the compact study summaries in docs/research/ instead.
/docs/research_map_*/

# Report rendering, intermediate document copies and local QA artifacts.
/output/
/tmp/
/docs/report/
/docs/presentation/

# Generated documents, exported figures and publication bundles.
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.png
*.svg
*.jpg
*.jpeg
*.gif
*.webp
*.zip
*.aux
*.log
*.fdb_latexmk
*.fls
/analysis/report_tools/**/figures/
/analysis/report_tools/**/results/

# Historical insertion drafts, original screenshots and plotting workspaces.
# Share source, README files and compact result summaries.
/docs/research/**/local/
